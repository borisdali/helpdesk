# Postgres target dedicated to pgBackRest faults (v0.30 Part C), kept as a
# separate image/container/volume from the plain `postgres` target used by
# db-backup-archiving-broken (Part B) — both faults want to control
# archive_command on their own terms, and pgBackRest itself refuses to back
# up unless archive_command actually invokes it (confirmed live: "archive_command
# '/bin/true' must contain pgbackrest"), so they cannot share a target.
#
# pgBackRest is baked into the image at build time rather than installed via
# a container-startup script — faster and more reliable for repeated CI runs
# than an `apt-get install` on every container start.
FROM postgres:16

RUN apt-get update \
    && apt-get install -y --no-install-recommends pgbackrest \
    && rm -rf /var/lib/apt/lists/*

# /etc/pgbackrest.conf is baked in at build time, not written by
# init-pgbackrest.sh's docker-entrypoint-initdb.d script — that script only
# runs on a genuinely empty PGDATA (first-ever bring-up). A container
# recreated against an already-populated pgdata-pgbackrest volume (e.g. a
# plain `docker compose down` + `up`, no `-v`) skips every init script,
# leaving /etc/pgbackrest.conf at the stock apt-package default — which has
# pg1-path commented out. `pgbackrest info` still works in that state (it
# only reads the persisted repo), which is exactly what let this go
# unnoticed until a real `backup` was attempted and failed with "[037]:
# backup command requires option: pg1-path". Confirmed live 2026-09-29 —
# baking the config here makes it correct regardless of volume state, no
# runtime dependency at all.
COPY pgbackrest.conf /etc/pgbackrest.conf
